{
  "id": "https://mdpe.dev/schemas/mdpe-microtask.schema.json",
  "title": "MDPE Microtask Schema",
  "description": "Validation schema for atomic micro-tasks in the MDPE Framework. Each microtask represents an indivisible unit of work with an IOQD contract (Input-Output-Quality-Dependencies) and AERT validation (Atomicity-Executability-Traceability-Testability).",
  "type": "object",
  "required": ["microtask"],
  "properties": {
    "microtask": {
      "type": "object",
      "description": "Root object containing all data for the atomic micro-task",
      "required": [
        "id",
        "title",
        "traceability",
        "category",
        "type",
        "architectural_layer",
        "description",
        "input",
        "output",
        "quality_criteria",
        "dependencies",
        "estimate",
        "aert_validation",
        "metadata"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^mt-\\d{3}-\\d{3}$",
          "description": "Unique ID in the format mt-XXX-YYY where XXX is the feature number and YYY is the microtask's sequence number",
          "examples": ["mt-001-001", "mt-001-015", "mt-003-007"]
        },
        "title": {
          "type": "string",
          "minLength": 10,
          "maxLength": 100,
          "description": "Clear and descriptive title for the micro-task. Must clearly communicate what will be done.",
          "examples": ["Implement TravelPackage Aggregate Root", "Create input validation for the CreateBooking command"]
        },
        "traceability": {
          "type": "object",
          "description": "Traceability information linking the microtask to its origin feature and strategic context",
          "required": ["feature_id", "feature_name", "strategic_context", "architectural_components"],
          "properties": {
            "feature_id": {
              "type": "string",
              "pattern": "^feat-\\d{3}$",
              "description": "ID of the origin feature in the format feat-XXX",
              "examples": ["feat-001", "feat-015"]
            },
            "feature_name": {
              "type": "string",
              "minLength": 5,
              "description": "Descriptive name of the origin feature"
            },
            "strategic_context": {
              "type": "string",
              "minLength": 20,
              "description": "Explanation of why this microtask exists and which business value it contributes"
            },
            "architectural_components": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              },
              "description": "List of impacted architectural components (e.g. Domain/Aggregates, Application/Commands)",
              "examples": [["Domain/Aggregates/TravelPackage", "Application/Commands/CreatePackageCommand"]]
            },
            "origin_decisions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^ad-\\d{3}$"
              },
              "description": "CONDITIONAL: the ad-NNN architecture decisions this microtask was derived from. Required only for a microtask born from a derived_work implication; absent on a normal microtask (ADR-005 D13)",
              "examples": [["ad-002"], ["ad-004", "ad-007"]]
            }
          }
        },
        "category": {
          "type": "string",
          "enum": ["backend", "frontend", "database", "infra", "docs", "tests"],
          "description": "Technical category of the microtask: backend (server logic), frontend (interface), database (persistence), infra (infrastructure), docs (documentation), tests (testing)"
        },
        "type": {
          "type": "string",
          "enum": ["implementation", "refactoring", "bugfix", "documentation", "testing"],
          "description": "Type of work: implementation (new code), refactoring (improvement), bugfix (fix), documentation (docs), testing (tests)"
        },
        "architectural_layer": {
          "type": "string",
          "enum": ["domain", "application", "infrastructure", "presentation", "tests", "docs"],
          "description": "Clean/DDD architecture layer where the work will be performed"
        },
        "description": {
          "type": "string",
          "minLength": 50,
          "description": "Detailed description of the microtask including what must be done, patterns to follow, and project conventions"
        },
        "input": {
          "type": "object",
          "description": "INPUT contract (I in IOQD): everything that must exist BEFORE starting the microtask",
          "required": ["required_artifacts", "technical_knowledge", "tools"],
          "properties": {
            "required_artifacts": {
              "type": "array",
              "description": "List of files, components, or documents that must exist before starting",
              "minItems": 0,
              "items": {
                "type": "object",
                "required": ["type", "description", "location", "status"],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": ["code", "documentation", "configuration", "schema"],
                    "description": "Type of the required artifact"
                  },
                  "description": {
                    "type": "string",
                    "description": "Description of the artifact and why it is needed"
                  },
                  "location": {
                    "type": "string",
                    "description": "File path or location of the artifact"
                  },
                  "status": {
                    "type": "string",
                    "enum": ["exists", "must_be_created_first"],
                    "description": "Whether the artifact already exists or must be created by a prior task"
                  }
                }
              }
            },
            "technical_knowledge": {
              "type": "array",
              "description": "List of technical knowledge required to execute the task",
              "minItems": 1,
              "items": {
                "type": "string"
              },
              "examples": [["Domain-Driven Design (Aggregates)", "CQRS Pattern", "Entity Framework Core"]]
            },
            "tools": {
              "type": "array",
              "description": "Development tools required, with versions",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["name", "version"],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Tool name"
                  },
                  "version": {
                    "type": "string",
                    "description": "Minimum required version"
                  }
                }
              }
            },
            "external_resources": {
              "type": "array",
              "description": "External APIs, services, or resources required (optional)",
              "items": {
                "type": "object",
                "required": ["type", "description", "availability"],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": ["api", "service", "library", "resource"],
                    "description": "Type of the external resource"
                  },
                  "description": {
                    "type": "string",
                    "description": "Description of the resource and its purpose"
                  },
                  "availability": {
                    "type": "string",
                    "enum": ["available", "needs_setup", "unavailable"],
                    "description": "Availability status of the resource"
                  }
                }
              }
            }
          }
        },
        "output": {
          "type": "object",
          "description": "OUTPUT contract (O in IOQD): everything that will be PRODUCED by the microtask",
          "required": ["generated_artifacts"],
          "properties": {
            "generated_artifacts": {
              "type": "array",
              "description": "List of files and components that will be created or modified",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["type", "description", "location"],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": ["code", "test", "documentation", "configuration", "migration"],
                    "description": "Type of the generated artifact"
                  },
                  "description": {
                    "type": "string",
                    "description": "What will be created and its purpose"
                  },
                  "location": {
                    "type": "string",
                    "description": "Path where the artifact will be created/modified"
                  },
                  "language": {
                    "type": "string",
                    "description": "Programming language (when applicable)"
                  },
                  "expected_coverage": {
                    "type": "string",
                    "description": "Expected test coverage (when type=test)"
                  }
                }
              }
            },
            "system_changes": {
              "type": "array",
              "description": "Structural changes to the system (database, API, etc) - optional",
              "items": {
                "type": "object",
                "required": ["type", "description", "impact"],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": ["database", "api", "configuration", "infrastructure"],
                    "description": "Type of system change"
                  },
                  "description": {
                    "type": "string",
                    "description": "Description of the change"
                  },
                  "impact": {
                    "type": "string",
                    "enum": ["low", "medium", "high"],
                    "description": "Level of impact of the change"
                  },
                  "breaking_change": {
                    "type": "boolean",
                    "description": "Whether this is a backward-compatibility-breaking change",
                    "default": false
                  }
                }
              }
            },
            "expected_metrics": {
              "type": "array",
              "description": "Expected quality metrics for the output - optional",
              "items": {
                "type": "object",
                "required": ["metric", "target"],
                "properties": {
                  "metric": {
                    "type": "string",
                    "description": "Metric name (e.g. coverage, complexity, performance)"
                  },
                  "target": {
                    "type": "string",
                    "description": "Target value for the metric (e.g. >= 90%, < 100ms)"
                  }
                }
              }
            }
          }
        },
        "quality_criteria": {
          "type": "object",
          "description": "QUALITY criteria (Q in IOQD): standards that must be met to consider the microtask complete",
          "required": ["functional", "non_functional", "code_quality"],
          "properties": {
            "functional": {
              "type": "array",
              "description": "Verifiable functional criteria - what the implementation must do correctly",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["criterion", "type", "how_to_verify"],
                "properties": {
                  "criterion": {
                    "type": "string",
                    "description": "Description of the functional criterion"
                  },
                  "type": {
                    "type": "string",
                    "description": "Category of the criterion (validation, business, integration, etc)"
                  },
                  "how_to_verify": {
                    "type": "string",
                    "description": "Verification method (unit test, integration, inspection)"
                  }
                }
              }
            },
            "non_functional": {
              "type": "array",
              "description": "Non-functional criteria (performance, security, etc) - optional but recommended",
              "minItems": 0,
              "items": {
                "type": "object",
                "required": ["criterion", "type", "how_to_verify"],
                "properties": {
                  "criterion": {
                    "type": "string",
                    "description": "Description of the non-functional requirement"
                  },
                  "type": {
                    "type": "string",
                    "enum": ["performance", "security", "resilience", "scalability", "usability"],
                    "description": "Category of the non-functional requirement"
                  },
                  "metric": {
                    "type": "string",
                    "description": "Quantifiable metric (e.g. response time < 100ms)"
                  },
                  "how_to_verify": {
                    "type": "string",
                    "description": "Verification method (benchmark, load test, analysis)"
                  }
                }
              }
            },
            "code_quality": {
              "type": "array",
              "description": "Code quality criteria (coverage, complexity, patterns)",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["criterion", "how_to_verify"],
                "properties": {
                  "criterion": {
                    "type": "string",
                    "description": "Quality standard to be met"
                  },
                  "how_to_verify": {
                    "type": "string",
                    "description": "Verification tool or method"
                  }
                }
              }
            },
            "documentation": {
              "type": "array",
              "description": "Documentation criteria - optional",
              "items": {
                "type": "object",
                "required": ["criterion", "how_to_verify"],
                "properties": {
                  "criterion": {
                    "type": "string",
                    "description": "Documentation requirement"
                  },
                  "how_to_verify": {
                    "type": "string",
                    "description": "How to verify the documentation is adequate"
                  }
                }
              }
            }
          }
        },
        "dependencies": {
          "type": "object",
          "description": "DEPENDENCIES (D in IOQD): relationships with other microtasks and external resources",
          "required": ["upstream", "downstream", "external"],
          "properties": {
            "upstream": {
              "type": "array",
              "description": "Microtasks that must be COMPLETE BEFORE this one starts (blockers)",
              "items": {
                "type": "object",
                "required": ["id", "title", "reason"],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^mt-\\d{3}-\\d{3}$",
                    "description": "ID of the upstream microtask"
                  },
                  "title": {
                    "type": "string",
                    "description": "Title of the upstream microtask for reference"
                  },
                  "reason": {
                    "type": "string",
                    "description": "Why this dependency exists"
                  }
                }
              }
            },
            "downstream": {
              "type": "array",
              "description": "Microtasks that depend on THIS one being complete (this one blocks others)",
              "items": {
                "type": "object",
                "required": ["id", "title", "reason"],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^mt-\\d{3}-\\d{3}$",
                    "description": "ID of the downstream microtask"
                  },
                  "title": {
                    "type": "string",
                    "description": "Title of the downstream microtask for reference"
                  },
                  "reason": {
                    "type": "string",
                    "description": "Why this task blocks the downstream one"
                  }
                }
              }
            },
            "external": {
              "type": "array",
              "description": "External dependencies (libraries, services, resources outside the project)",
              "items": {
                "type": "object",
                "required": ["type", "name"],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": ["library", "service", "resource", "api"],
                    "description": "Type of the external dependency"
                  },
                  "name": {
                    "type": "string",
                    "description": "Name of the dependency"
                  },
                  "version": {
                    "type": "string",
                    "description": "Required version"
                  },
                  "installed": {
                    "type": "boolean",
                    "description": "Whether the library is already installed in the project"
                  },
                  "available": {
                    "type": "boolean",
                    "description": "Whether the service/resource is available for use"
                  }
                }
              }
            }
          }
        },
        "estimate": {
          "type": "object",
          "description": "Effort estimate to complete the microtask. Maximum total time of 8 hours ensures atomicity.",
          "required": ["development_time", "testing_time", "documentation_time", "total_time", "complexity", "uncertainty"],
          "properties": {
            "development_time": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 8,
              "description": "Hours of code development (maximum 8h to ensure atomicity)"
            },
            "testing_time": {
              "type": "number",
              "minimum": 0,
              "description": "Hours for creating and running tests"
            },
            "documentation_time": {
              "type": "number",
              "minimum": 0,
              "description": "Hours for technical documentation"
            },
            "total_time": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 8,
              "description": "Total time in hours (development + testing + documentation). If > 8h, split the task."
            },
            "complexity": {
              "type": "string",
              "enum": ["low", "medium", "high"],
              "description": "Technical complexity level: low (simple code), medium (moderate logic), high (complex algorithms)"
            },
            "uncertainty": {
              "type": "string",
              "enum": ["low", "medium", "high"],
              "description": "Uncertainty level of the estimate: low (high confidence), medium (some risks), high (many unknowns)"
            },
            "estimate_justification": {
              "type": "string",
              "minLength": 20,
              "description": "Explanation of how the estimate was calculated, including risk factors considered"
            }
          }
        },
        "aert_validation": {
          "type": "object",
          "description": "AERT validation: guarantee that the microtask is Atomic, Executable, Traceable, and Testable",
          "required": ["atomicity", "executability", "traceability", "testability"],
          "properties": {
            "atomicity": {
              "type": "object",
              "description": "A - Atomicity: task cannot be split further without losing meaning",
              "required": ["validated", "justification"],
              "properties": {
                "validated": {
                  "type": "boolean",
                  "description": "Whether atomicity was validated (true = atomic)"
                },
                "justification": {
                  "type": "string",
                  "minLength": 10,
                  "description": "Why the task is (or is not) atomic"
                }
              }
            },
            "executability": {
              "type": "object",
              "description": "E - Executability: clear input and output, can be executed in isolation",
              "required": ["validated", "justification"],
              "properties": {
                "validated": {
                  "type": "boolean",
                  "description": "Whether executability was validated (true = executable)"
                },
                "justification": {
                  "type": "string",
                  "minLength": 10,
                  "description": "Why the task is (or is not) executable in isolation"
                }
              }
            },
            "traceability": {
              "type": "object",
              "description": "T - Traceability: connected to the origin feature and strategic objectives",
              "required": ["validated", "justification"],
              "properties": {
                "validated": {
                  "type": "boolean",
                  "description": "Whether traceability was validated (true = traceable)"
                },
                "justification": {
                  "type": "string",
                  "minLength": 10,
                  "description": "How the task connects to business objectives"
                }
              }
            },
            "testability": {
              "type": "object",
              "description": "T - Testability: objective and verifiable quality criteria",
              "required": ["validated", "justification"],
              "properties": {
                "validated": {
                  "type": "boolean",
                  "description": "Whether testability was validated (true = testable)"
                },
                "justification": {
                  "type": "string",
                  "minLength": 10,
                  "description": "How the task's success can be verified"
                }
              }
            }
          }
        },
        "risks": {
          "type": "array",
          "description": "List of risks identified for this specific microtask - optional",
          "items": {
            "type": "object",
            "required": ["id", "type", "description", "probability", "impact", "mitigation"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^risk-mt-\\d{3}-\\d{3}-\\d{3}$",
                "description": "Unique risk ID in the format risk-mt-{feature}-{task}-{seq}",
                "examples": ["risk-mt-001-001-001"]
              },
              "type": {
                "type": "string",
                "enum": ["technical", "business", "resources", "schedule"],
                "description": "Risk category: technical (complexity, technology), business (requirements), resources (people, tools), schedule (deadlines)"
              },
              "description": {
                "type": "string",
                "description": "Clear description of the risk and its potential impact"
              },
              "probability": {
                "type": "string",
                "enum": ["low", "medium", "high"],
                "description": "Probability of the risk materializing"
              },
              "impact": {
                "type": "string",
                "enum": ["low", "medium", "high"],
                "description": "Impact if the risk materializes"
              },
              "mitigation": {
                "type": "object",
                "description": "Strategy and actions to mitigate the risk",
                "required": ["strategy", "actions"],
                "properties": {
                  "strategy": {
                    "type": "string",
                    "description": "General mitigation approach (avoid, transfer, mitigate, accept)"
                  },
                  "actions": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    },
                    "description": "Specific mitigation actions"
                  }
                }
              }
            }
          }
        },
        "technical_notes": {
          "type": "array",
          "description": "Additional technical notes: architectural decisions, evaluated alternatives, useful links - optional",
          "items": {
            "type": "string"
          }
        },
        "metadata": {
          "type": "object",
          "description": "Control and tracking metadata for the microtask",
          "required": ["version", "created_at", "created_by", "updated_at", "status", "tags", "technical_priority"],
          "properties": {
            "version": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+$",
              "description": "Semantic version of the microtask (major.minor.patch)",
              "examples": ["1.0.0", "1.1.0", "2.0.0"]
            },
            "created_at": {
              "type": "string",
              "format": "date",
              "description": "Creation date in YYYY-MM-DD format"
            },
            "created_by": {
              "type": "string",
              "description": "Name of the architect or tech lead who created the microtask"
            },
            "updated_at": {
              "type": "string",
              "format": "date",
              "description": "Last update date in YYYY-MM-DD format"
            },
            "status": {
              "type": "string",
              "enum": ["pending", "in_progress", "completed", "blocked", "cancelled"],
              "description": "Current status: pending (not started), in_progress (in development), completed (finished), blocked (waiting on a dependency), cancelled (discarded)"
            },
            "tags": {
              "type": "array",
              "description": "Tags for categorization and search (e.g. ddd, cqrs, aggregate, api)",
              "items": {
                "type": "string"
              }
            },
            "technical_priority": {
              "type": "string",
              "enum": ["low", "medium", "high", "critical"],
              "description": "Technical execution priority: low (can wait), medium (important), high (urgent), critical (blocker)"
            }
          }
        }
      }
    }
  },
  "examples": [
    {
      "microtask": {
        "id": "mt-001-001",
        "title": "Implement TravelPackage Aggregate Root",
        "traceability": {
          "feature_id": "feat-001",
          "feature_name": "Travel Package Management",
          "strategic_context": "Enables creating and managing travel packages, a core functionality of the tourism system",
          "architectural_components": ["Domain/Aggregates/TravelPackage", "Domain/ValueObjects/PackagePrice"]
        },
        "category": "backend",
        "type": "implementation",
        "architectural_layer": "domain",
        "description": "Implement the TravelPackage class as an Aggregate Root following DDD patterns, including invariant validation and domain events.",
        "input": {
          "required_artifacts": [],
          "technical_knowledge": ["Domain-Driven Design", "Aggregate Pattern"],
          "tools": [{"name": ".NET CLI", "version": "8.0"}]
        },
        "output": {
          "generated_artifacts": [
            {"type": "code", "description": "TravelPackage class", "location": "src/Domain/Aggregates/TravelPackage.cs", "language": "csharp"}
          ]
        },
        "quality_criteria": {
          "functional": [{"criterion": "Invariant validation", "type": "validation", "how_to_verify": "Unit tests"}],
          "non_functional": [],
          "code_quality": [{"criterion": "Coverage >= 90%", "how_to_verify": "dotnet test --collect:coverage"}]
        },
        "dependencies": {
          "upstream": [],
          "downstream": [{"id": "mt-001-002", "title": "Create CreatePackage Command", "reason": "Needs the Aggregate for commands"}],
          "external": []
        },
        "estimate": {
          "development_time": 4,
          "testing_time": 1,
          "documentation_time": 0.5,
          "total_time": 5.5,
          "complexity": "medium",
          "uncertainty": "low",
          "estimate_justification": "Well-defined aggregate, clear DDD patterns"
        },
        "aert_validation": {
          "atomicity": {"validated": true, "justification": "The aggregate is an indivisible unit"},
          "executability": {"validated": true, "justification": "No upstream dependencies"},
          "traceability": {"validated": true, "justification": "Connected to feat-001"},
          "testability": {"validated": true, "justification": "Objective criteria defined"}
        },
        "metadata": {
          "version": "1.0.0",
          "created_at": "2025-01-15",
          "created_by": "Tech Lead",
          "updated_at": "2025-01-15",
          "status": "pending",
          "tags": ["ddd", "aggregate", "domain"],
          "technical_priority": "high"
        }
      }
    }
  ]
}
