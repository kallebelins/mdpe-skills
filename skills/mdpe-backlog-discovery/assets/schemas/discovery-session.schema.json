{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mdpe.dev/schemas/discovery-session.schema.json",
  "title": "Discovery Session Schema",
  "description": "JSON Schema for validating MDPE Framework Discovery sessions",
  "version": "1.0.0",
  "type": "object",
  "required": ["discovery_session"],
  "properties": {
    "discovery_session": {
      "type": "object",
      "required": ["metadata", "participants", "agenda", "outputs", "next_steps"],
      "properties": {
        "metadata": {
          "type": "object",
          "required": ["id", "version", "session_date", "duration_hours", "format", "facilitator", "product", "discovery_type"],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^discovery-session-[0-9]{8}-[0-9]{3}$",
              "description": "Unique session ID"
            },
            "version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "session_date": {
              "type": "string",
              "format": "date"
            },
            "duration_hours": {
              "type": "number",
              "minimum": 1,
              "maximum": 16
            },
            "format": {
              "type": "string",
              "enum": ["in-person", "remote", "hybrid"]
            },
            "facilitator": {
              "type": "string",
              "minLength": 1
            },
            "product": {
              "type": "string",
              "minLength": 1
            },
            "discovery_type": {
              "type": "string",
              "enum": ["initial", "incremental", "exploratory"]
            }
          }
        },
        "participants": {
          "type": "object",
          "required": ["product_owner"],
          "properties": {
            "product_owner": {
              "type": "object",
              "required": ["name", "email", "role"],
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "email": {"type": "string", "format": "email"},
                "role": {"type": "string", "minLength": 1}
              }
            },
            "stakeholders": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "role"],
                "properties": {
                  "name": {"type": "string", "minLength": 1},
                  "role": {"type": "string", "minLength": 1},
                  "area": {"type": "string"}
                }
              }
            },
            "technical_team": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "role"],
                "properties": {
                  "name": {"type": "string", "minLength": 1},
                  "role": {"type": "string", "minLength": 1}
                }
              }
            },
            "optional_guests": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "role"],
                "properties": {
                  "name": {"type": "string", "minLength": 1},
                  "role": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        },
        "agenda": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["stage", "duration_minutes", "objective", "activities"],
            "properties": {
              "stage": {
                "type": "string",
                "minLength": 5
              },
              "duration_minutes": {
                "type": "integer",
                "minimum": 5,
                "maximum": 240
              },
              "objective": {
                "type": "string",
                "minLength": 10
              },
              "activities": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 5
                }
              },
              "tools": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 3
                }
              },
              "expected_output": {
                "type": "string"
              }
            }
          }
        },
        "outputs": {
          "type": "object",
          "required": ["cognitive_backlog"],
          "properties": {
            "cognitive_backlog": {
              "type": "object",
              "required": ["file", "status"],
              "properties": {
                "file": {
                  "type": "string",
                  "pattern": "\\.yml$"
                },
                "status": {
                  "type": "string",
                  "enum": ["draft", "review", "approved"]
                },
                "features_identified": {
                  "type": "integer",
                  "minimum": 0
                },
                "features_must_have": {
                  "type": "integer",
                  "minimum": 0
                },
                "features_should_have": {
                  "type": "integer",
                  "minimum": 0
                },
                "features_could_have": {
                  "type": "integer",
                  "minimum": 0
                },
                "features_wont_have": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "personas_identified": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "name"],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^persona-[0-9]{3}$"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "critical_hypotheses": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["hypothesis", "validation", "confidence"],
                "properties": {
                  "hypothesis": {"type": "string", "minLength": 10},
                  "validation": {"type": "string", "minLength": 5},
                  "confidence": {"type": "string", "enum": ["high", "medium", "low"]}
                }
              }
            },
            "identified_risks": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["type", "description", "impact", "probability"],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": ["technology", "regulatory", "market", "operational", "financial"]
                  },
                  "description": {"type": "string", "minLength": 10},
                  "impact": {"type": "string", "enum": ["high", "medium", "low"]},
                  "probability": {"type": "string", "enum": ["high", "medium", "low"]}
                }
              }
            }
          }
        },
        "next_steps": {
          "type": "object",
          "properties": {
            "required_validations": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["action", "responsible"],
                "properties": {
                  "action": {"type": "string", "minLength": 5},
                  "responsible": {"type": "string", "minLength": 1},
                  "deadline": {"type": "string"}
                }
              }
            },
            "next_event": {
              "type": "object",
              "required": ["type", "responsible", "objective"],
              "properties": {
                "type": {"type": "string", "minLength": 5},
                "expected_date": {"type": "string", "format": "date"},
                "responsible": {"type": "string", "minLength": 1},
                "objective": {"type": "string", "minLength": 10}
              }
            }
          }
        },
        "facilitator_notes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["timestamp", "note"],
            "properties": {
              "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}$"},
              "note": {"type": "string", "minLength": 10}
            }
          }
        },
        "participant_feedback": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["participant", "rating"],
            "properties": {
              "participant": {"type": "string", "minLength": 1},
              "rating": {"type": "integer", "minimum": 1, "maximum": 5},
              "comment": {"type": "string"}
            }
          }
        },
        "attachments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "file"],
            "properties": {
              "type": {"type": "string", "minLength": 3},
              "file": {"type": "string", "minLength": 5}
            }
          }
        }
      }
    }
  }
}

