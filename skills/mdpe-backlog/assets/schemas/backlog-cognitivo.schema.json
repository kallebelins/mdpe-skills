{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hubturismo.com/schemas/backlog-cognitivo.schema.json",
  "title": "MDPE Backlog Cognitivo Schema",
  "description": "Schema de validação para Backlog Cognitivo do MDPE Framework. O Backlog Cognitivo é o output estruturado da fase de Discovery, contendo features priorizadas antes da transformação em micro-tarefas executáveis.",
  "type": "object",
  "required": ["feature"],
  "properties": {
    "feature": {
      "type": "object",
      "description": "Funcionalidade de alto nível que agrupa várias funcionalidades menores relacionadas. Representa uma capacidade do produto.",
      "required": [
        "id",
        "nome",
        "descricao",
        "categoria",
        "prioridade",
        "funcionalidades",
        "criterios_valor",
        "personas_atendidas",
        "hipoteses",
        "dependencias",
        "riscos",
        "criterios_aceitacao",
        "metadata"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^feat-\\d{3}$",
          "description": "ID único no formato feat-XXX onde XXX é número sequencial de 3 dígitos",
          "examples": ["feat-001", "feat-015", "feat-100"]
        },
        "nome": {
          "type": "string",
          "minLength": 5,
          "maxLength": 100,
          "description": "Nome descritivo da feature que comunica claramente seu propósito",
          "examples": ["Gestão de Pacotes de Viagem", "Sistema de Reservas Online"]
        },
        "descricao": {
          "type": "string",
          "minLength": 20,
          "description": "Descrição detalhada explicando o que a feature resolve, qual problema atende e quais benefícios traz"
        },
        "categoria": {
          "type": "string",
          "enum": ["core", "complementar", "exploratoria"],
          "description": "Classificação da feature: core (essencial para o produto existir), complementar (agrega valor mas não é essencial), exploratoria (para validar novas ideias)"
        },
        "prioridade": {
          "type": "object",
          "description": "Dados de priorização usando métodos MoSCoW, Matriz Valor×Esforço e opcionalmente RICE",
          "required": ["moscow", "valor_negocio", "esforco_estimado", "score_prioridade", "justificativa_priorizacao"],
          "properties": {
            "moscow": {
              "type": "string",
              "enum": ["must-have", "should-have", "could-have", "wont-have"],
              "description": "Classificação MoSCoW: must-have (essencial, sem isso não há produto), should-have (importante, agrega valor), could-have (desejável se houver tempo), wont-have (não será feito nesta iteração)"
            },
            "valor_negocio": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10,
              "description": "Valor de negócio em escala 1-10 onde 10 representa altíssimo valor para o negócio"
            },
            "esforco_estimado": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10,
              "description": "Esforço estimado em escala 1-10 onde 10 representa altíssimo esforço de implementação"
            },
            "score_prioridade": {
              "type": "number",
              "description": "Score calculado: valor_negocio × (10 - esforco_estimado). Quanto maior, mais prioritário.",
              "examples": [50, 72, 90]
            },
            "rice": {
              "type": "object",
              "description": "Score RICE opcional para priorização mais refinada: (Reach × Impact × Confidence) / Effort",
              "properties": {
                "reach": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Quantas pessoas serão impactadas por período (ex: usuários/mês)"
                },
                "impact": {
                  "type": "number",
                  "enum": [0.25, 0.5, 1, 2, 3],
                  "description": "Impacto individual: 3=massivo, 2=alto, 1=médio, 0.5=baixo, 0.25=mínimo"
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100,
                  "description": "Confiança nas estimativas em porcentagem (0-100%)"
                },
                "effort": {
                  "type": "number",
                  "minimum": 0.1,
                  "description": "Esforço em pessoa-meses (mínimo 0.1)"
                },
                "score": {
                  "type": "number",
                  "description": "Score RICE calculado: (Reach × Impact × Confidence%) / Effort"
                }
              }
            },
            "justificativa_priorizacao": {
              "type": "string",
              "minLength": 20,
              "description": "Explicação dos fatores considerados na priorização desta feature"
            }
          }
        },
        "funcionalidades": {
          "type": "object",
          "description": "Funcionalidades específicas agrupadas nesta feature. Cada feature deve ter de 5 a 30 funcionalidades.",
          "required": ["total", "lista"],
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0,
              "description": "Número total de funcionalidades agrupadas nesta feature"
            },
            "lista": {
              "type": "array",
              "description": "Lista detalhada das funcionalidades",
              "minItems": 0,
              "items": {
                "type": "object",
                "required": ["id", "descricao", "prioridade"],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^func-\\d{3}$",
                    "description": "ID único da funcionalidade no formato func-XXX",
                    "examples": ["func-001", "func-015"]
                  },
                  "descricao": {
                    "type": "string",
                    "minLength": 10,
                    "description": "Descrição clara da funcionalidade"
                  },
                  "prioridade": {
                    "type": "string",
                    "enum": ["alta", "media", "baixa"],
                    "description": "Prioridade dentro da feature"
                  }
                }
              }
            }
          }
        },
        "criterios_valor": {
          "type": "array",
          "description": "Critérios mensuráveis que definem o sucesso da feature",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["criterio", "metrica", "target"],
            "properties": {
              "criterio": {
                "type": "string",
                "description": "Nome do critério de sucesso"
              },
              "metrica": {
                "type": "string",
                "description": "Como o critério será medido"
              },
              "target": {
                "type": "string",
                "description": "Valor alvo a ser atingido"
              }
            }
          }
        },
        "personas_atendidas": {
          "type": "array",
          "description": "Personas que serão beneficiadas por esta feature",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "nome", "impacto", "necessidades_atendidas"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^persona-\\d{3}$",
                "description": "ID da persona no formato persona-XXX",
                "examples": ["persona-001", "persona-002"]
              },
              "nome": {
                "type": "string",
                "description": "Nome descritivo da persona"
              },
              "impacto": {
                "type": "string",
                "enum": ["baixo", "medio", "alto"],
                "description": "Nível de impacto da feature para esta persona"
              },
              "necessidades_atendidas": {
                "type": "array",
                "description": "Lista de necessidades da persona que serão atendidas",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "hipoteses": {
          "type": "array",
          "description": "Hipóteses de negócio que sustentam esta feature e devem ser validadas",
          "minItems": 0,
          "items": {
            "type": "object",
            "required": ["id", "tipo", "hipotese", "validacao", "confianca", "evidencias"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^hip-feat-\\d{3}-\\d{3}$",
                "description": "ID único da hipótese no formato hip-feat-{feature}-{seq}",
                "examples": ["hip-feat-001-001", "hip-feat-001-002"]
              },
              "tipo": {
                "type": "string",
                "enum": ["valor", "usabilidade", "viabilidade"],
                "description": "Tipo de hipótese: valor (entrega benefício), usabilidade (usuário consegue usar), viabilidade (é tecnicamente possível)"
              },
              "hipotese": {
                "type": "string",
                "minLength": 10,
                "description": "Declaração da hipótese em formato testável"
              },
              "validacao": {
                "type": "string",
                "description": "Status ou método de validação da hipótese"
              },
              "confianca": {
                "type": "string",
                "enum": ["alta", "media", "baixa"],
                "description": "Nível de confiança na hipótese baseado em evidências"
              },
              "evidencias": {
                "type": "array",
                "description": "Evidências que suportam ou refutam a hipótese",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "dependencias": {
          "type": "object",
          "description": "Dependências de negócio (outras features) e técnicas (componentes, APIs)",
          "required": ["negocio", "tecnicas"],
          "properties": {
            "negocio": {
              "type": "array",
              "description": "Features que devem existir para esta funcionar corretamente no negócio",
              "items": {
                "type": "object",
                "required": ["feature_id", "motivo", "tipo"],
                "properties": {
                  "feature_id": {
                    "type": "string",
                    "pattern": "^feat-\\d{3}$",
                    "description": "ID da feature dependência"
                  },
                  "motivo": {
                    "type": "string",
                    "description": "Razão da dependência"
                  },
                  "tipo": {
                    "type": "string",
                    "enum": ["hard", "soft"],
                    "description": "Tipo: hard (bloqueante, obrigatória), soft (recomendada, não bloqueante)"
                  }
                }
              }
            },
            "tecnicas": {
              "type": "array",
              "description": "Dependências técnicas (módulos, APIs, serviços, bibliotecas)",
              "items": {
                "type": "object",
                "required": ["tipo", "nome", "status"],
                "properties": {
                  "tipo": {
                    "type": "string",
                    "enum": ["modulo", "api", "servico", "biblioteca"],
                    "description": "Tipo da dependência técnica"
                  },
                  "nome": {
                    "type": "string",
                    "description": "Nome do componente/serviço"
                  },
                  "status": {
                    "type": "string",
                    "enum": ["disponivel", "em_desenvolvimento", "planejado"],
                    "description": "Status atual da dependência"
                  }
                }
              }
            }
          }
        },
        "riscos": {
          "type": "array",
          "description": "Riscos identificados para esta feature (tecnológicos, regulatórios, de negócio ou recursos)",
          "minItems": 0,
          "items": {
            "type": "object",
            "required": ["id", "tipo", "descricao", "probabilidade", "impacto", "mitigacao"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^risk-feat-\\d{3}-\\d{3}$",
                "description": "ID único do risco no formato risk-feat-{feature}-{seq}",
                "examples": ["risk-feat-001-001", "risk-feat-001-002"]
              },
              "tipo": {
                "type": "string",
                "enum": ["tecnologia", "regulatorio", "negocio", "recursos"],
                "description": "Categoria do risco: tecnologia (complexidade técnica), regulatorio (compliance, leis), negocio (mercado, requisitos), recursos (pessoas, tempo, orçamento)"
              },
              "descricao": {
                "type": "string",
                "description": "Descrição clara do risco e seu potencial impacto"
              },
              "probabilidade": {
                "type": "string",
                "enum": ["baixa", "media", "alta"],
                "description": "Probabilidade de o risco se materializar"
              },
              "impacto": {
                "type": "string",
                "enum": ["baixo", "medio", "alto"],
                "description": "Impacto caso o risco se materialize"
              },
              "mitigacao": {
                "type": "string",
                "description": "Estratégia de mitigação do risco"
              }
            }
          }
        },
        "criterios_aceitacao": {
          "type": "array",
          "description": "Critérios de aceitação high-level - condições observáveis e verificáveis que definem quando a feature está completa",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 10
          }
        },
        "notas_discovery": {
          "type": "array",
          "description": "Notas e observações coletadas durante sessões de Discovery - opcional",
          "items": {
            "type": "object",
            "required": ["data", "autor", "nota"],
            "properties": {
              "data": {
                "type": "string",
                "format": "date",
                "description": "Data da nota no formato YYYY-MM-DD"
              },
              "autor": {
                "type": "string",
                "description": "Nome do autor da nota"
              },
              "nota": {
                "type": "string",
                "description": "Conteúdo da observação ou insight"
              }
            }
          }
        },
        "metadata": {
          "type": "object",
          "description": "Metadados de controle e versionamento da feature",
          "required": ["versao", "data_criacao", "data_atualizacao", "status", "changelog"],
          "properties": {
            "versao": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+$",
              "description": "Versão semântica da feature (major.minor.patch)",
              "examples": ["1.0.0", "1.1.0", "2.0.0"]
            },
            "data_criacao": {
              "type": "string",
              "format": "date",
              "description": "Data de criação no formato YYYY-MM-DD"
            },
            "data_atualizacao": {
              "type": "string",
              "format": "date",
              "description": "Data da última atualização no formato YYYY-MM-DD"
            },
            "status": {
              "type": "string",
              "enum": ["backlog", "em_transformacao", "transformada", "em_desenvolvimento", "concluida"],
              "description": "Status no ciclo MDPE: backlog (aguardando), em_transformacao (sendo decomposta), transformada (microtasks criadas), em_desenvolvimento (codificação), concluida (entregue)"
            },
            "changelog": {
              "type": "array",
              "description": "Histórico de alterações da feature",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["versao", "data", "descricao"],
                "properties": {
                  "versao": {
                    "type": "string",
                    "pattern": "^\\d+\\.\\d+\\.\\d+$",
                    "description": "Versão da alteração"
                  },
                  "data": {
                    "type": "string",
                    "format": "date",
                    "description": "Data da alteração"
                  },
                  "descricao": {
                    "type": "string",
                    "description": "Descrição do que foi alterado"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "examples": [
    {
      "feature": {
        "id": "feat-001",
        "nome": "Gestão de Pacotes de Viagem",
        "descricao": "Permite criar, editar e gerenciar pacotes de viagem completos, incluindo hospedagem, transporte e atividades. Funcionalidade core do sistema de turismo.",
        "categoria": "core",
        "prioridade": {
          "moscow": "must-have",
          "valor_negocio": 10,
          "esforco_estimado": 6,
          "score_prioridade": 40,
          "rice": {
            "reach": 1000,
            "impact": 3,
            "confidence": 80,
            "effort": 4,
            "score": 600
          },
          "justificativa_priorizacao": "Funcionalidade core que habilita o negócio principal. Sem ela, não há produto viável."
        },
        "funcionalidades": {
          "total": 3,
          "lista": [
            {"id": "func-001", "descricao": "Criar novo pacote de viagem com dados básicos", "prioridade": "alta"},
            {"id": "func-002", "descricao": "Adicionar serviços ao pacote (hotel, voo, atividades)", "prioridade": "alta"},
            {"id": "func-003", "descricao": "Calcular preço total do pacote", "prioridade": "alta"}
          ]
        },
        "criterios_valor": [
          {"criterio": "Tempo de criação de pacote", "metrica": "Minutos para criar pacote completo", "target": "< 5 minutos"}
        ],
        "personas_atendidas": [
          {"id": "persona-001", "nome": "Agente de Viagens", "impacto": "alto", "necessidades_atendidas": ["Criar pacotes rapidamente", "Precificar corretamente"]}
        ],
        "hipoteses": [
          {"id": "hip-feat-001-001", "tipo": "valor", "hipotese": "Agentes criarão mais pacotes se o processo for simplificado", "validacao": "Validado em entrevistas", "confianca": "alta", "evidencias": ["5 entrevistas com agentes"]}
        ],
        "dependencias": {
          "negocio": [],
          "tecnicas": [{"tipo": "api", "nome": "API de Fornecedores", "status": "disponivel"}]
        },
        "riscos": [
          {"id": "risk-feat-001-001", "tipo": "tecnologia", "descricao": "Integração com sistemas legados pode ser complexa", "probabilidade": "media", "impacto": "alto", "mitigacao": "Criar camada de abstração para integrações"}
        ],
        "criterios_aceitacao": [
          "Agente consegue criar pacote completo em menos de 5 minutos",
          "Preço é calculado automaticamente com margem configurável",
          "Pacote pode ser salvo como rascunho e editado posteriormente"
        ],
        "metadata": {
          "versao": "1.0.0",
          "data_criacao": "2025-01-10",
          "data_atualizacao": "2025-01-15",
          "status": "backlog",
          "changelog": [
            {"versao": "1.0.0", "data": "2025-01-10", "descricao": "Versão inicial pós Discovery"}
          ]
        }
      }
    }
  ]
}

